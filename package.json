{
  "private": true,
  "name": "r2uploader",
  "description": "User-friendly GUI application for Cloudflare R2",
  "version": "2.0.0",
  "bin": {
    "r2uploader": "cli/r2uploader-cli.mjs"
  },
  "author": "nazha <maoxiaoke@outlook.com>",
  "main": "app/background.js",
  "scripts": {
    "dev": "nextron",
    "build": "nextron build",
    "typecheck": "tsc --noEmit && tsc -p renderer/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:prod": "npm audit --omit=dev",
    "verify": "npm run typecheck && npm test",
    "package": "nextron build && electron-builder build --config electron-builder.config.cjs --publish never",
    "publish": "nextron build && electron-builder build --config electron-builder.config.cjs --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/lib-storage": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@openai/apps-sdk-ui": "^0.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "electron-serve": "^1.3.0",
    "electron-updater": "^6.8.9",
    "node-fetch": "^2.7.0",
    "selfsigned": "^3.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.52",
    "@vitest/coverage-v8": "^4.1.10",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "lightningcss": "^1.33.0",
    "next": "^14.2.4",
    "nextron": "^9.4.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "lodash": "4.18.1",
    "js-yaml": "4.3.0"
  }
}
